{$DOMAIN:localhost} {
	# FastAPI is reachable from the webapp over the docker network
	# (SERVICE_URL=http://service:8000). Do not proxy it publicly — that
	# would bypass Google auth on the Next.js API routes.
	reverse_proxy webapp:3000

	encode gzip zstd

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	log {
		output file /data/access.log {
			roll_size 10mb
			roll_keep 3
		}
	}
}
